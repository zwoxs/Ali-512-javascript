# ================= Binance TR Coin Bot Ayarlari =================
# Bu dosyayi ".env" olarak kopyalayin: cp .env.example .env
# API anahtarlarinizi ASLA git'e commit etmeyin!

# --- Calisma modu ---
# paper  = Gercek para KULLANMAZ, sanal bakiye ile simulasyon (guvenli, varsayilan)
# live   = GERCEK emir gonderir! Once paper modda ve backtest ile test edin.
# signal = Islem ACMAZ, sadece sinyal bildirimi gonderir (Telegram/Discord)
TRADE_MODE=paper

# --- Islem ciftleri ve zaman araligi ---
# Birden fazla sembol virgul ile: BTCTRY,ETHTRY
# Sembol basina strateji atanabilir: BTCTRY:ema_rsi,ETHTRY:supertrend
SYMBOLS=BTCTRY
INTERVAL=15m
POLL_SECONDS=30
# debug | info | warn | error
LOG_LEVEL=info

# --- Strateji secimi: ema_rsi | macd | bollinger | donchian | supertrend ---
STRATEGY=ema_rsi

# EMA + RSI stratejisi
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# MACD stratejisi
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Bollinger stratejisi
BB_PERIOD=20
BB_STDDEV=2

# Donchian kanal kirilimi (Turtle)
DONCHIAN_ENTRY=20
DONCHIAN_EXIT=10

# SuperTrend
SUPERTREND_PERIOD=10
SUPERTREND_MULT=3

# --- Sermaye ve pozisyon boyutlama ---
PAPER_BALANCE=10000
# percent = bakiyenin sabit yuzdesi | risk = stop mesafesine gore profesyonel boyutlama
SIZING_MODE=percent
POSITION_PCT=25
# risk modunda: islem basina riske edilen sermaye yuzdesi (tipik: 0.5 - 2)
RISK_PER_TRADE_PCT=1

# --- Cikis kurallari ---
# HAZIR PROFILLER: cp profiles/guvenli.env .env  (tum korumalar acik, kucuk sermaye)
#                  cp profiles/dengeli.env .env  (koruma + buyume dengesi)
# percent = sabit yuzde stoplar | atr = volatiliteye uyumlu stoplar (onerilen)
STOP_MODE=percent
STOP_LOSS_PCT=2
TAKE_PROFIT_PCT=4
# Iz suren stop: zirveden bu kadar % geri cekilince sat (0 = kapali)
TRAILING_STOP_PCT=0
# Iz suren stop modu: percent | atr (chandelier: zirve - N x ATR, kar kilitleme)
TRAILING_MODE=percent
CHANDELIER_MULT=3
# Erken basabas: kar bu yuzdeyi bir kez gorunce stop girise cekilir (0 = kapali)
BREAKEVEN_TRIGGER_PCT=0
# Zaman asimi: bu kadar mumdur KARSIZ bekleyen pozisyon kapatilir (0 = kapali)
MAX_HOLD_CANDLES=0
# Odul/risk zorlamasi: TP/SL orani bunun altindaysa bot BASLAMAZ (0 = kapali)
MIN_RR=0
# ATR modu ayarlari: stop = giris - N x ATR, hedef = giris + M x ATR
ATR_PERIOD=14
ATR_STOP_MULT=2
ATR_TP_MULT=3

# Kismi kar alma (scale-out): kar bu yuzdeye ulasinca pozisyonun bir kismi
# kapatilir ve stop basabas noktasina cekilir - kalan pozisyon zarar edemez.
# (0 = kapali)
PARTIAL_TP_PCT=0
PARTIAL_TP_SIZE=50

# --- Ust zaman dilimi (HTF) trend filtresi ---
# Acikken dusus trendinde AL sinyalleri engellenir ("dusen bicagi tutma" onlenir)
HTF_FILTER=false
# 1 HTF mumu = kac taban mum (or. 15m x 4 = 1 saatlik trend)
HTF_MULTIPLE=4
HTF_EMA_PERIOD=20

# --- ADX rejim filtresi ---
# Acikken trendsiz/testere piyasada (ADX < minimum) AL sinyalleri engellenir
ADX_FILTER=false
ADX_PERIOD=14
ADX_MINIMUM=20

# --- Piramitleme: kazanan pozisyona kademeli ekleme ---
# Fiyat son girisin PYRAMID_TRIGGER_PCT ustune cikinca ekleme yapilir.
# Her kademe = ilk pozisyon x PYRAMID_SIZE_FACTOR^kademe (kuculen kademeler).
PYRAMID_MAX_ADDONS=0
PYRAMID_TRIGGER_PCT=2
PYRAMID_SIZE_FACTOR=0.5

# --- Portfoy seviyesi limitler (0 = kapali) ---
# Ayni anda en fazla kac sembolde pozisyon olabilir
MAX_OPEN_POSITIONS=0
# Pozisyonlardaki sermaye / toplam deger bu yuzdeyi asamaz
MAX_EXPOSURE_PCT=0
# ACIL FREN: toplam sermaye zirveden bu kadar % duserse bot yeni islem ACMAZ.
# Kalicidir (yeniden baslatmada korunur) - en guclu zarar sinirlayici. (0 = kapali)
MAX_TOTAL_DRAWDOWN_PCT=0
# Volatilite bekcisi: ATR/fiyat bu yuzdenin ustundeyse giris yok (0 = kapali)
MAX_ENTRY_ATR_PCT=0
# Minimum emir tutari (TRY): komisyonun kari yedigi kucuk emirler atlanir (0 = kapali)
MIN_ORDER_NOTIONAL=0

# --- Devre kesiciler (sermaye koruma) ---
# Gunluk zarar bu yuzdeye ulasinca o gun yeni pozisyon acilmaz
MAX_DAILY_LOSS_PCT=5
# Bu kadar ust uste zarar sonrasi sogurma suresi baslar
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES=60

# --- Islem maliyetleri ---
FEE_PCT=0.1
# Paper/backtest gerceklik payi: emirlerin aleyhte dolma yuzdesi
SLIPPAGE_PCT=0.05

# --- Gercek zamanli veri ve izleme ---
# WebSocket kline akisi (Node 21+ gerektirir; yoksa otomatik REST'e duser)
WS_ENABLED=true
WS_BASE_URL=wss://stream.binance.com:9443
# Web izleme paneli portu (0 = kapali). http://127.0.0.1:8080
DASHBOARD_PORT=0

# --- API adresleri ---
MARKET_BASE_URL=https://api.binance.com
TRADE_BASE_URL=https://api.trbinance.com

# --- Binance TR API anahtarlari (sadece live mod) ---
# Sadece SPOT TRADE yetkisi verin, CEKIM yetkisi ASLA vermeyin, IP kisitlayin.
BINANCE_TR_API_KEY=
BINANCE_TR_API_SECRET=

# --- Bildirimler (istege bagli, ikisi birden kullanilabilir) ---
# Telegram: BotFather'dan token alin; chat id icin @userinfobot kullanabilirsiniz
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: Sunucu Ayarlari > Entegrasyonlar > Webhook URL'si
DISCORD_WEBHOOK_URL=
# Gunluk ozet raporu saati (yerel saat, -1 = kapali)
DAILY_REPORT_HOUR=21
