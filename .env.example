# ================= Binance TR Coin Bot Ayarlari =================
# Bu dosyayi ".env" olarak kopyalayin: cp .env.example .env
# API anahtarlarinizi ASLA git'e commit etmeyin!

# --- Calisma modu ---
# paper  = Gercek para KULLANMAZ, sanal bakiye ile simulasyon (guvenli, varsayilan)
# live   = GERCEK emir gonderir! Once paper modda test edin.
TRADE_MODE=paper

# --- Islem cifti ve zaman araligi ---
SYMBOL=BTCTRY
INTERVAL=15m
# Kac saniyede bir piyasa kontrol edilsin
POLL_SECONDS=30

# --- Strateji parametreleri (EMA kesisimi + RSI filtresi) ---
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# --- Risk yonetimi ---
# Baslangic sanal bakiyesi (paper mod, TRY)
PAPER_BALANCE=10000
# Her islemde bakiyenin yuzde kaci kullanilsin (0-100)
POSITION_PCT=25
# Zarar durdur / kar al yuzdeleri
STOP_LOSS_PCT=2
TAKE_PROFIT_PCT=4
# Islem basina komisyon orani (%) - Binance TR spot ~%0.1
FEE_PCT=0.1

# --- API adresleri ---
# Piyasa verisi (mum/kline) icin kullanilir; TRY pariteleri global API'de de mevcuttur
MARKET_BASE_URL=https://api.binance.com
# Canli emirler icin Binance TR Open API
TRADE_BASE_URL=https://api.trbinance.com

# --- Binance TR API anahtarlari (sadece live mod icin gerekli) ---
BINANCE_TR_API_KEY=
BINANCE_TR_API_SECRET=
