# ================== DENGELI PROFIL ==================
# Koruma katmanlari acik ama giris filtreleri daha esnek; kismi kar +
# piramitleme birlikte kullanilir (kazanani buyut, kaybedeni hemen kes).
# Kullanim: cp profiles/dengeli.env .env

TRADE_MODE=paper
SYMBOLS=BTCTRY,ETHTRY
INTERVAL=1h
STRATEGY=supertrend
POLL_SECONDS=30

SIZING_MODE=risk
RISK_PER_TRADE_PCT=1.5
PAPER_BALANCE=10000

STOP_MODE=atr
ATR_PERIOD=14
ATR_STOP_MULT=2
ATR_TP_MULT=5
MIN_RR=1.5

BREAKEVEN_TRIGGER_PCT=2
TRAILING_MODE=atr
CHANDELIER_MULT=3.5
PARTIAL_TP_PCT=3
PARTIAL_TP_SIZE=40

MAX_HOLD_CANDLES=72

HTF_FILTER=true
HTF_MULTIPLE=4
HTF_EMA_PERIOD=20
ADX_FILTER=true
ADX_MINIMUM=20
MAX_ENTRY_ATR_PCT=6

MAX_DAILY_LOSS_PCT=5
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES=120
MAX_TOTAL_DRAWDOWN_PCT=18

MAX_OPEN_POSITIONS=2
MAX_EXPOSURE_PCT=60
MIN_ORDER_NOTIONAL=100

# Kazanan pozisyona 2 kuculen kademe eklenebilir
PYRAMID_MAX_ADDONS=2
PYRAMID_TRIGGER_PCT=2.5
PYRAMID_SIZE_FACTOR=0.5

FEE_PCT=0.1
SLIPPAGE_PCT=0.05
LOG_LEVEL=info
DAILY_REPORT_HOUR=21
