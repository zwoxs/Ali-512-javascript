# ================== GUVENLI PROFIL ==================
# Oncelik: sermaye koruma. Az ama sececi islem, tum koruma katmanlari acik.
# Kucuk sermaye (2-10k TRY) icin tasarlandi.
# Kullanim: cp profiles/guvenli.env .env  (sonra API anahtarlarini ekleyin)
#
# NOT: Hicbir ayar kar garantisi vermez. Bu profil kayiplari SINIRLAMAK ve
# kazanci KORUMAK icin tasarlandi - once backtest + paper modda dogrulayin.

TRADE_MODE=paper
SYMBOLS=BTCTRY
INTERVAL=1h
STRATEGY=ema_rsi
POLL_SECONDS=30

# Boyutlama: islem basina sermayenin sadece %1'i riske edilir
SIZING_MODE=risk
RISK_PER_TRADE_PCT=1
PAPER_BALANCE=3000

# Volatiliteye uyumlu stoplar + saglam odul/risk orani (1.5 minimum zorunlu)
STOP_MODE=atr
ATR_PERIOD=14
ATR_STOP_MULT=2
ATR_TP_MULT=4
MIN_RR=1.5

# Kar koruma: erken basabas + chandelier iz suren stop + kismi kar alma
BREAKEVEN_TRIGGER_PCT=1.5
TRAILING_MODE=atr
CHANDELIER_MULT=3
PARTIAL_TP_PCT=2.5
PARTIAL_TP_SIZE=50

# Olu pozisyon temizligi: 48 mumdur (2 gun) karsiz bekleyen pozisyondan cik
MAX_HOLD_CANDLES=48

# Giris filtreleri: sadece trendli ve sakin piyasada islem
HTF_FILTER=true
HTF_MULTIPLE=4
HTF_EMA_PERIOD=20
ADX_FILTER=true
ADX_PERIOD=14
ADX_MINIMUM=22
MAX_ENTRY_ATR_PCT=4

# Devre kesiciler: siki
MAX_DAILY_LOSS_PCT=3
MAX_CONSECUTIVE_LOSSES=2
COOLDOWN_MINUTES=180
MAX_TOTAL_DRAWDOWN_PCT=12

# Portfoy limitleri ve emir korumasi
MAX_OPEN_POSITIONS=1
MAX_EXPOSURE_PCT=40
MIN_ORDER_NOTIONAL=100

# Islem maliyetleri
FEE_PCT=0.1
SLIPPAGE_PCT=0.05

# Piramitleme kapali (guvenli profilde ekleme yok)
PYRAMID_MAX_ADDONS=0

LOG_LEVEL=info
DAILY_REPORT_HOUR=21
